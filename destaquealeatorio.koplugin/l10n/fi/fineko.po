"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Aplicar ao livro: grava os metadados e a capa selecionados."
msgstr "Käytä kirjaan: tallentaa valitut metatiedot ja kansikuvan."

msgid "Aplicando capa…"
msgstr "Käytetään kansikuvaa…"

msgid "Autor(es)"
msgstr "Tekijä(t)"

msgid "Cancelar"
msgstr "Peruuta"

msgid "%1 candidata(s) — tocar para ver e escolher"
msgstr "%1 ehdokas/ehdokasta — napauta katsellaksesi ja valitaksesi"

msgid "Não foi possível exibir a capa (formato não suportado)."
msgstr "Kansikuvaa ei voitu näyttää (muotoa ei tueta)."

msgid "escolha uma opção; toque longo mostra o texto completo"
msgstr "valitse vaihtoehto; näytä koko teksti pitämällä painettuna"

msgid "Capa"
msgstr "Kansikuva"

msgid "%1 capa(s) — toque para visualizar; toque longo para escolher"
msgstr "%1 kansikuva(a) — napauta esikatsellaksesi; valitse pitämällä painettuna"

msgid "Descrição"
msgstr "Kuvaus"

msgid "Baixando capas…"
msgstr "Ladataan kansikuvia…"

msgid "Editar"
msgstr "Muokkaa"

msgid "Editar manualmente…"
msgstr "Muokkaa manuaalisesti…"

msgid "(vazio — tocar para adicionar)"
msgstr "(tyhjä — lisää napauttamalla)"

msgid "Erro ao salvar metadados: "
msgstr "Virhe metatietojen tallennuksessa: "

msgid "Digite o ISBN-10 ou ISBN-13 do livro.\nDeixe vazio para ver/editar os metadados atuais do documento."
msgstr "Anna kirjan ISBN-10 tai ISBN-13.\nJätä tyhjäksi, jos haluat katsella/muokata asiakirjan nykyisiä metatietoja."

msgid "ISBN inválido. Informe 10 ou 13 dígitos (apenas números)."
msgstr "Virheellinen ISBN. Anna 10 tai 13 numeroa (vain numeroita)."

msgid "ISBN:"
msgstr "ISBN:"

msgid "Palavras-chave"
msgstr "Avainsanat"

msgid "Idioma"
msgstr "Kieli"

msgid "Metadados e capa atualizados com sucesso."
msgstr "Metatiedot ja kansikuva päivitetty onnistuneesti."

msgid "Agrega metadados de livros por ISBN de várias fontes gratuitas (Google Books, Open Library, Inventaire, Amazon), com edição campo a campo e escolha da capa de maior qualidade."
msgstr "Kokoaa kirjojen metatiedot ISBN:n perusteella useista ilmaisista lähteistä (Google Books, Open Library, Inventaire, Amazon), kenttäkohtaisella muokkauksella ja parhaan laatuisen kansikuvan valinnalla."

msgid "Metadados encontrados"
msgstr "Metatiedot löytyivät"

msgid "Atualizar metadados"
msgstr "Päivitä metatiedot"

msgid "N/D"
msgstr "N/A"

msgid "Nenhuma capa válida encontrada."
msgstr "Kelvollista kansikuvaa ei löytynyt."

msgid "nenhuma encontrada"
msgstr "ei yhtään löytynyt"

msgid "nenhuma válida"
msgstr "ei yhtään kelvollista"

msgid "Nenhum livro encontrado para este ISBN.\nVerifique a conexão e tente novamente."
msgstr "Tälle ISBN:lle ei löytynyt kirjaa.\nTarkista yhteys ja yritä uudelleen."

msgid "%1 resultado(s); toque longo mostra o texto completo"
msgstr "%1 tulos/tulosta; näytä koko teksti pitämällä painettuna"

msgid "Salvar"
msgstr "Tallenna"

msgid "Não foi possível salvar os metadados."
msgstr "Metatietoja ei voitu tallentaa."

msgid "Metadados salvos.\nNão foi possível aplicar a capa."
msgstr "Metatiedot tallennettu.\nKansikuvaa ei voitu käyttää."

msgid "Buscar metadados"
msgstr "Etsi metatiedot"

msgid "Buscar"
msgstr "Etsi"

msgid "Buscar metadados — ISBN"
msgstr "Etsi metatiedot — ISBN"

msgid "Buscando metadados…"
msgstr "Etsitään metatietoja…"

msgid "Série"
msgstr "Sarja"

msgid "Número na série"
msgstr "Numero sarjassa"

msgid "tocar para ver/trocar"
msgstr "napauta katsellaksesi/vaihtaaksesi"

msgid "Título"
msgstr "Otsikko"

msgid "%1 imagem(ns) única(s) de %2 candidata(s) — fontes com a mesma capa foram agrupadas.\nToque para visualizar; toque longo para escolher."
msgstr "%1 ainutlaatuinen/ainutlaatuista kuvaa %2 ehdokkaasta — lähteet, joilla on sama kansikuva, on ryhmitelty.\nNapauta esikatsellaksesi; valitse pitämällä painettuna."

msgid "Metadados atualizados com sucesso."
msgstr "Metatiedot päivitetty onnistuneesti."

msgid "Fechar"
msgstr "Sulje"

msgid "Destaque"
msgstr "Korostus"

msgid "Exibe um destaque aleatório dos seus livros ao abrir o KOReader ou ao retornar da suspensão."
msgstr "Näyttää satunnaisen korostuksen kirjoistasi, kun KOReader avataan tai palataan lepotilasta."

msgid "mais"
msgstr "lisää"

msgid "Destaque aleatório"
msgstr "Satunnainen korostus"

msgid "Nenhum destaque encontrado nos seus livros."
msgstr "Kirjoistasi ei löytynyt korostusta."

msgid "Nota: %1"
msgstr "Huomautus: %1"

msgid "Ver um destaque agora"
msgstr "Näytä korostus nyt"

msgid "Mostrar ao abrir o KOReader"
msgstr "Näytä, kun KOReader avataan"

msgid "Mostrar ao retornar da suspensão"
msgstr "Näytä, kun palataan lepotilasta"

msgid "Selo de progresso/conclusão"
msgstr "Edistymis-/valmistumismerkki"

msgid "Faixa central com o título"
msgstr "Keskikaista otsikolla"

msgid "No modo mosaico, exibe sobre cada capa uma faixa central com o título\ndo livro e um selo sutil com o estado de leitura (porcentagem ou concluído).\n\nFunciona como camada sobre o plugin nativo \"Cover browser\", que precisa estar\nem modo mosaico."
msgstr "Mosaiikkitilassa näyttää jokaisen kansikuvan päällä keskikaistan, jossa on kirjan otsikko,\nja hienovaraisen merkin lukutilasta (prosentti tai valmis).\n\nToimii kerroksena natiivin \"Cover browser\" -laajennuksen päällä, jonka on oltava\nmosaiikkitilassa."

msgid "Estante mosaico"
msgstr "Mosaiikkihylly"
