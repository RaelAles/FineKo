"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: is\n"

msgid "Aplicar ao livro: grava os metadados e a capa selecionados."
msgstr "Beita á bók: vistar valin lýsigögn og forsíðu."

msgid "Aplicando capa…"
msgstr "Beiti forsíðu…"

msgid "Autor(es)"
msgstr "Höfundur(/ar)"

msgid "Cancelar"
msgstr "Hætta við"

msgid "%1 candidata(s) — tocar para ver e escolher"
msgstr "%1 kandídat(ar) — ýttu til að skoða og velja"

msgid "Não foi possível exibir a capa (formato não suportado)."
msgstr "Ekki tókst að sýna forsíðuna (óstudd snið)."

msgid "escolha uma opção; toque longo mostra o texto completo"
msgstr "veldu valkost; haltu inni til að sýna allan textann"

msgid "Capa"
msgstr "Forsíða"

msgid "%1 capa(s) — toque para visualizar; toque longo para escolher"
msgstr "%1 forsíða(/forsíður) — ýttu til að forskoða; haltu inni til að velja"

msgid "Descrição"
msgstr "Lýsing"

msgid "Baixando capas…"
msgstr "Hleður forsíðum…"

msgid "Editar"
msgstr "Breyta"

msgid "Editar manualmente…"
msgstr "Breyta handvirkt…"

msgid "(vazio — tocar para adicionar)"
msgstr "(autt — ýttu til að bæta við)"

msgid "Erro ao salvar metadados: "
msgstr "Villa við vistun lýsigagna: "

msgid "Digite o ISBN-10 ou ISBN-13 do livro.\nDeixe vazio para ver/editar os metadados atuais do documento."
msgstr "Sláðu inn ISBN-10 eða ISBN-13 bókarinnar.\nSkildu eftir autt til að skoða/breyta núverandi lýsigögnum skjalsins."

msgid "ISBN inválido. Informe 10 ou 13 dígitos (apenas números)."
msgstr "Ógilt ISBN. Sláðu inn 10 eða 13 tölur (aðeins tölur)."

msgid "ISBN:"
msgstr "ISBN:"

msgid "Palavras-chave"
msgstr "Lykilorð"

msgid "Idioma"
msgstr "Tungumál"

msgid "Metadados e capa atualizados com sucesso."
msgstr "Lýsigögn og forsíða uppfærð."

msgid "Agrega metadados de livros por ISBN de várias fontes gratuitas (Google Books, Open Library, Inventaire, Amazon), com edição campo a campo e escolha da capa de maior qualidade."
msgstr "Safnar saman lýsigögnum bóka eftir ISBN frá nokkrum ókeypis heimildum (Google Books, Open Library, Inventaire, Amazon), með breytingum reit fyrir reit og vali á forsíðunni í bestu gæðum."

msgid "Metadados encontrados"
msgstr "Lýsigögn fundust"

msgid "Atualizar metadados"
msgstr "Uppfæra lýsigögn"

msgid "N/D"
msgstr "N/A"

msgid "Nenhuma capa válida encontrada."
msgstr "Engin gild forsíða fannst."

msgid "nenhuma encontrada"
msgstr "engin fannst"

msgid "nenhuma válida"
msgstr "engin gild"

msgid "Nenhum livro encontrado para este ISBN.\nVerifique a conexão e tente novamente."
msgstr "Engin bók fannst fyrir þetta ISBN.\nAthugaðu tenginguna og reyndu aftur."

msgid "%1 resultado(s); toque longo mostra o texto completo"
msgstr "%1 niðurstaða(/niðurstöður); haltu inni til að sýna allan textann"

msgid "Salvar"
msgstr "Vista"

msgid "Não foi possível salvar os metadados."
msgstr "Gat ekki vistað lýsigögnin."

msgid "Metadados salvos.\nNão foi possível aplicar a capa."
msgstr "Lýsigögn vistuð.\nEkki tókst að beita forsíðunni."

msgid "Buscar metadados"
msgstr "Leita að lýsigögnum"

msgid "Buscar"
msgstr "Leita"

msgid "Buscar metadados — ISBN"
msgstr "Leita að lýsigögnum — ISBN"

msgid "Buscando metadados…"
msgstr "Leita að lýsigögnum…"

msgid "Série"
msgstr "Röð"

msgid "Número na série"
msgstr "Númer í röðinni"

msgid "tocar para ver/trocar"
msgstr "ýttu til að skoða/breyta"

msgid "Título"
msgstr "Titill"

msgid "%1 imagem(ns) única(s) de %2 candidata(s) — fontes com a mesma capa foram agrupadas.\nToque para visualizar; toque longo para escolher."
msgstr "%1 einstök mynd(ir) af %2 kandídat(um) — heimildir með sömu forsíðu voru flokkaðar.\nÝttu til að forskoða; haltu inni til að velja."

msgid "Metadados atualizados com sucesso."
msgstr "Lýsigögn uppfærð."

msgid "Fechar"
msgstr "Loka"

msgid "Destaque"
msgstr "Auðkenning"

msgid "Exibe um destaque aleatório dos seus livros ao abrir o KOReader ou ao retornar da suspensão."
msgstr "Sýnir handahófskennda auðkenningu úr bókunum þínum þegar KOReader er opnað eða þegar komið er úr svefni."

msgid "mais"
msgstr "meira"

msgid "Destaque aleatório"
msgstr "Handahófskennd auðkenning"

msgid "Nenhum destaque encontrado nos seus livros."
msgstr "Engin auðkenning fannst í bókunum þínum."

msgid "Nota: %1"
msgstr "Athugasemd: %1"

msgid "Ver um destaque agora"
msgstr "Sýna auðkenningu núna"

msgid "Mostrar ao abrir o KOReader"
msgstr "Sýna þegar KOReader er opnað"

msgid "Mostrar ao retornar da suspensão"
msgstr "Sýna þegar komið er úr svefni"

msgid "Selo de progresso/conclusão"
msgstr "Merki um framvindu/lokið"

msgid "Faixa central com o título"
msgstr "Miðrönd með titlinum"

msgid "No modo mosaico, exibe sobre cada capa uma faixa central com o título\ndo livro e um selo sutil com o estado de leitura (porcentagem ou concluído).\n\nFunciona como camada sobre o plugin nativo \"Cover browser\", que precisa estar\nem modo mosaico."
msgstr "Í mósaíkham sýnir það yfir hverri forsíðu miðrönd með titli bókarinnar\nog lítið merki með lestrarstöðu (prósenta eða lokið).\n\nVirkar sem lag ofan á innbyggða viðbótina \"Cover browser\", sem verður að vera\ní mósaíkham."

msgid "Estante mosaico"
msgstr "Mósaík-hilla"
